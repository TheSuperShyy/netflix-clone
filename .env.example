# TMDB v4 read access token (Bearer). Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OpenSubtitles REST API key. Get one at https://www.opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=netflix-ni-yul v0.1

# Set to "true" to enable Pluto TV (uses reverse-engineered endpoints; not officially supported)
ENABLE_PLUTO=false

# JustWatch locale for deep-link fallback
JUSTWATCH_LOCALE=us
